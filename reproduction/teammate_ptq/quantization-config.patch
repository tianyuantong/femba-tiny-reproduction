+    for name, module in observers.items():
+        if module.counter == 0:
             # Brevitas normally omits these parameters, which breaks strict FP32 reload.
             state_dict[prefix + name + ".value"] = module.value.detach()
             unobserved.append(name)
     local_metadata["femba_unobserved_scales"] = unobserved


+def _validate_checkpoint_configuration(
+    model: nn.Module, state_dict: dict, prefix: str, local_metadata: dict
+) -> None:
+    saved = local_metadata.get("femba_quantization")
+    fresh = local_metadata.get("femba_unobserved_scales", [])
+    if not isinstance(fresh, list) or not all(isinstance(name, str) for name in fresh):
+        raise ValueError("Invalid fresh-observer checkpoint metadata")
+    available = {name for name in _runtime_observers(model)
+                 if prefix + name + ".value" in state_dict}
+    if len(fresh) != len(set(fresh)) or not set(fresh).issubset(available):
+        raise ValueError("Fresh-observer metadata does not match checkpoint scale tensors")
+    if "femba_quantization" not in local_metadata:
+        source = config_from_mapping({})
+        enabled = not bool(fresh)
+        observer_names = available
+    else:
