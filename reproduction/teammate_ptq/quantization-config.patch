+"""Explicit three-level mapping contract, independent of the Brevitas model.
+
+For finite floating x, code is -1 when x < -threshold * scale, +1 when
+x > threshold * scale, and 0 otherwise (both boundaries map to 0).
+Reconstruction is code * scale, with a positive constant, nonlearned scale.
+Fake quantization has an identity straight-through gradient with respect to x.
+This interface neither packs codes nor configures model weight/activation proxies.
+"""
+
+from collections.abc import Mapping
+from dataclasses import dataclass
+import math
+from numbers import Real
+
+import torch
+
+
+MAPPING_ID = "symmetric_ternary"
+MAPPING_VERSION = 1
+
+
+def _finite_real(value: object, name: str) -> float:
+    if isinstance(value, bool) or not isinstance(value, Real):
+        raise TypeError(f"{name} must be a real number")
+    try:
+        result = float(value)
+    except OverflowError as error:
+        raise ValueError(f"{name} is outside the finite float range") from error
+    if not math.isfinite(result):
+        raise ValueError(f"{name} must be finite")
+    return result
+
+
+@dataclass(frozen=True, kw_only=True)
+class TernaryMapping:
+    """Versioned mapping with explicit scale and threshold; no inferred defaults."""
+
+    scale: float
+    threshold: float
+    ste: str = "identity"
+
+    def __post_init__(self) -> None:
+        scale = _finite_real(self.scale, "scale")
+        threshold = _finite_real(self.threshold, "threshold")
+        if scale <= 0 or threshold < 0:
+            raise ValueError("scale must be positive and threshold must be nonnegative")
+        if not math.isfinite(scale * threshold):
+            raise ValueError("threshold * scale must be finite")
+        if self.ste != "identity":
+            raise ValueError("This ternary mapping supports only the identity STE")
+        object.__setattr__(self, "scale", scale)
+        object.__setattr__(self, "threshold", threshold)
+
+    def to_dict(self) -> dict:
+        """Return portable JSON values, including all mapping/gradient semantics."""
+        return {"mapping": MAPPING_ID, "version": MAPPING_VERSION, "codes": [-1, 0, 1],
+                "scale": self.scale, "threshold": self.threshold, "threshold_units": "scale",
+                "zero_boundary": "inclusive", "ste": self.ste}
+
+    @classmethod
+    def from_dict(cls, config: Mapping) -> "TernaryMapping":
+        if not isinstance(config, Mapping):
+            raise TypeError("Ternary configuration must be a mapping")
+        required = {"mapping", "version", "codes", "scale", "threshold", "threshold_units",
+                    "zero_boundary", "ste"}
+        if set(config) != required:
+            raise ValueError("Ternary configuration fields are missing or unknown")
+        if (config["mapping"] != MAPPING_ID or type(config["version"]) is not int
+                or config["version"] != MAPPING_VERSION):
+            raise ValueError("Unknown ternary mapping or version")
+        if (config["codes"] != [-1, 0, 1] or any(type(code) is not int for code in config["codes"])
+                or config["threshold_units"] != "scale"
+                or config["zero_boundary"] != "inclusive"):
+            raise ValueError("Ternary codes or threshold semantics differ from the mapping contract")
+        return cls(scale=config["scale"], threshold=config["threshold"], ste=config["ste"])
+
+
+def _validate_tensor(values: torch.Tensor, mapping: TernaryMapping) -> tuple[torch.Tensor, torch.Tensor]:
+    if not isinstance(values, torch.Tensor) or not torch.is_floating_point(values):
+        raise TypeError("Ternary mapping requires a floating-point tensor")
+    if not isinstance(mapping, TernaryMapping):
+        raise TypeError("mapping must be a TernaryMapping")
+    if not torch.isfinite(values).all():
+        raise ValueError("Ternary input contains nonfinite values")
+    scale = values.new_tensor(mapping.scale)
+    boundary = values.new_tensor(mapping.scale * mapping.threshold)
+    if not torch.isfinite(scale) or scale <= 0 or not torch.isfinite(boundary):
+        raise ValueError("Ternary scale and boundary must be representable in the input dtype")
+    if mapping.threshold > 0 and boundary == 0:
+        raise ValueError("Ternary boundary underflows in the input dtype")
+    return scale, boundary
+
+
+def _codes(values: torch.Tensor, boundary: torch.Tensor) -> torch.Tensor:
+    return (values > boundary).to(torch.int8) - (values < -boundary).to(torch.int8)
+
+
+def ternary_codes(values: torch.Tensor, mapping: TernaryMapping) -> torch.Tensor:
+    """Map to signed int8 codes with exactly the allowed set {-1, 0, 1}."""
+    _, boundary = _validate_tensor(values, mapping)
+    return _codes(values, boundary)
+
+
+def ternary_fake_quantize(values: torch.Tensor, mapping: TernaryMapping) -> torch.Tensor:
+    """Return code * scale in the input dtype/device, with identity STE; never mutate x."""
+    scale, boundary = _validate_tensor(values, mapping)
+    mapped = _codes(values, boundary).to(values.dtype) * scale
+    # This order preserves mapped values even when x is much larger than scale.
+    return mapped + (values - values.detach())
