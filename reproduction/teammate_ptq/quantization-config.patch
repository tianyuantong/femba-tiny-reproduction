+"""Validated, serializable precision settings for the existing FEMBA graph.
+
+Only uniform fake quantization is integrated into the model. Full-range two-bit
+quantization has four codes; narrow-range weights can have three codes, but
+neither implies the explicit threshold/scale/STE ternary mapping contract.
+"""
+
+from collections.abc import Mapping
+from typing import Any
+
+
+CONFIG_FIELDS = ("weight_bit_width", "activation_bit_width",
+                 "weight_quant_scheme", "activation_quant_scheme")
+
+
+def quantization_config(
+    weight_bit_width: int = 8,
+    activation_bit_width: int = 8,
+    weight_quant_scheme: str = "uniform",
+    activation_quant_scheme: str = "uniform",
+) -> dict[str, int | str]:
+    """Return canonical settings, rejecting unsupported widths and mappings."""
+    for name, value in (("weight_bit_width", weight_bit_width),
+                        ("activation_bit_width", activation_bit_width)):
+        if type(value) is not int:
+            raise TypeError(f"{name} must be an integer, not a boolean or coerced value")
+        if not 2 <= value <= 16:
+            raise ValueError(f"{name} must be between 2 and 16")
+    for name, value in (("weight_quant_scheme", weight_quant_scheme),
+                        ("activation_quant_scheme", activation_quant_scheme)):
+        if not isinstance(value, str):
+            raise TypeError(f"{name} must be a string")
+        if value != "uniform":
+            raise ValueError(
+                f"{name}={value!r} is not integrated into the FEMBA model; "
+                "use 'uniform'. Ternary requires its explicit three-level mapping "
+                "interface and is not uniform two-bit quantization."
+            )
+    return {"weight_bit_width": weight_bit_width,
+            "activation_bit_width": activation_bit_width,
+            "weight_quant_scheme": weight_quant_scheme,
+            "activation_quant_scheme": activation_quant_scheme}
+
+
+def config_from_mapping(mapping: Mapping[str, Any]) -> dict[str, int | str]:
+    """Read model hyperparameters; missing legacy fields mean uniform W8A8."""
+    if not isinstance(mapping, Mapping):
+        raise TypeError("Quantization settings must be a mapping")
+    return quantization_config(**{name: mapping[name] for name in CONFIG_FIELDS if name in mapping})
+
+
+def model_quantization_config(model: Any) -> dict[str, int | str]:
+    """Return a validated copy; old models without settings use uniform W8A8."""
+    return config_from_mapping(getattr(model, "quantization_config", {}))
