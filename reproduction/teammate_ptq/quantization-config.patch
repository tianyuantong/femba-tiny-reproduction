+
+def _runtime_observers(model: nn.Module) -> dict[str, nn.Module]:
+    return {name: module for name, module in model.named_modules()
+            if isinstance(module, ParameterFromRuntimeStatsScaling)}
+

 def _save_unobserved_scales(
     model: nn.Module, state_dict: dict, prefix: str, local_metadata: dict
 ) -> None:
+    observers = _runtime_observers(model)
+    local_metadata["femba_quantization"] = {
+        **model_quantization_config(model), "enabled": model.quantization_enabled,
+        "observer_names": sorted(observers),
+    }
