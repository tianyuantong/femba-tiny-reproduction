 from collections.abc import Mapping
 from dataclasses import dataclass
 import math
+
+from brevitas.inject.enum import (QuantType, RestrictValueType, ScalingImplType,
+                                  ScalingPerOutputType, StatsOp)
+from brevitas.quant.solver import WeightQuantSolver
+
+from models.femba_quantization import TERNARY_THRESHOLD
+
+
+class TernaryWeightPerTensorMeanAbs(WeightQuantSolver):
+    """Brevitas weight quantizer for the FEMBA ternary scheme.
+
+    Per tensor: scale = mean|w| (recomputed from the weights every forward),
+    code = +1 if w > 0.7 * scale, -1 if w < -0.7 * scale, else 0; dequantized
+    value = code * scale. Gradients use Brevitas' ternary straight-through
+    estimator. This is the Ternary Weight Networks rule with the threshold
+    constant 0.7 and the mean-absolute scale shared by threshold and output.
+    """
+    quant_type = QuantType.TERNARY
+    threshold = TERNARY_THRESHOLD
+    scaling_impl_type = ScalingImplType.STATS
+    scaling_stats_op = StatsOp.AVE
+    scaling_per_output_type = ScalingPerOutputType.TENSOR
+    restrict_scaling_type = RestrictValueType.FP
+    scaling_min_val = 1e-10
+    signed = True
 from numbers import Real
 
